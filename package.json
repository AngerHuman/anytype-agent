{
  "name": "anytype-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@nestjs/testing": "^11",
    "@types/bun": "latest",
    "@types/ssh2": "^1.15.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "type-fest": "^5.10.0"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "dev": "bun --watch ./src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.83",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@anyproto/anytype-mcp": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "ai": "^7.0.152",
    "eventsource-parser": "^4.1.0",
    "flat": "^6.0.1",
    "lodash": "^4.18.1",
    "nestjs-cls": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "^1.17.0",
    "typebox": "^1.3.17"
  }
}
