# ─────────────────────────────────────────────────────────────────────────────
#  Anytype Agent — example environment
#
#  Naming: "__" is the nesting separator (ANYTYPE__API_URL → config.ANYTYPE.API_URL).
#  A single LLM provider may omit the index; several providers use LLM__0__…, LLM__1__…
# ─────────────────────────────────────────────────────────────────────────────

# ── Anytype daemon ───────────────────────────────────────────────────────────
ANYTYPE__API_URL=http://127.0.0.1:31012
ANYTYPE__API_KEY=
ANYTYPE__BOT_NAME=
# ANYTYPE__API_VERSION=2025-11-08

# ── Observer settings (defaults shown, uncomment to override) ────────────────
# SETTINGS__DEBOUNCE_MS=800
# SETTINGS__RETRY_DELAY_MS=3000
# SETTINGS__SCAN_INTERVAL_MS=60000

# ── LLM provider: OpenAI-compatible API (no SSH required) ────────────────────
LLM__NAME=opencode-api
LLM__MODE=api
LLM__API_URL=
LLM__API_KEY=
LLM__MODEL=glm-5.3-flash

# ── LLM provider: remote CLI over SSH ────────────────────────────────────────
# Alternative to the API block above: comment that block out first, or give both
# blocks their own index (LLM__0__… / LLM__1__…) — without indexes they merge.
# LLM__NAME=agy-remote
# LLM__MODE=cli
# LLM__CLI=/Users/me/.local/bin/agy
# LLM__SSH=ssh://me@host.docker.internal:22
# LLM__SSH_KEY=/keys/id_ed25519
# LLM__MODEL=opencode-go/glm-5.3-flash   # required for opencode, ignored by agy
